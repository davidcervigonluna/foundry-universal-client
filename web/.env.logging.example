# Optional Entra defaults (pre-filled in the UI; not secrets). Leave empty for a
# fully agnostic build where the user configures identity in the UI.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_FOUNDRY_SCOPE=https://ai.azure.com/.default

# ---- Frontend logging (browser console, auth-focused) ----
# VITE_LOG_LEVEL: info | warn | trace   (default: warn)
#   trace shows MSAL flow details (token presence/expiry, silent vs popup).
#   Credentials are never printed.
VITE_LOG_LEVEL=warn
