PORT=8080
SERVE_STATIC=false
ALLOWED_HOST_SUFFIXES=.services.ai.azure.com,.openai.azure.com,.cognitiveservices.azure.com
AUTH_ENABLED=false
# ---- Logging ----
# LOG_LEVEL: info | warn | trace   (default: warn)
#   info  -> only info messages (request lifecycle, upstream calls, usage)
#   warn  -> info + warnings + errors (fallbacks, 4xx/5xx, UNKNOWN unhandled events with payload)
#   trace -> everything: full request bodies, every stream event, all payloads,
#            prompts and responses (FOR DEBUGGING/TESTING, not production).
# Credentials (tokens/secrets/api-key) are never printed at any level.
LOG_LEVEL=warn
# LOG_JSON=true   # optional: structured JSON logs (e.g. for App Insights)
# DEBUG_STREAM=true  # deprecated alias for LOG_LEVEL=trace